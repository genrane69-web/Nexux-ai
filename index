<!DOCTYPE html>
<html>
<head>
<base target="_top">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070b10; --panel:#0d1620; --border:#1c2c38;
    --cyan:#5ee7ff; --cyan-dim:#274652; --amber:#ffb454;
    --text:#dce8ee; --text-dim:#5c7282; --danger:#ff6b6b; --ok:#5eff9d;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'JetBrains Mono',monospace;
    padding:20px 16px 60px; min-height:100vh;
    background-image:radial-gradient(circle at 50% 0%, #0d1a24 0%, #070b10 60%);
  }
  .header{display:flex; align-items:center; gap:14px; margin-bottom:22px;}
  .ring{
    width:40px;height:40px;border-radius:50%;
    border:2px solid var(--cyan); position:relative; flex:0 0 auto;
    box-shadow:0 0 12px var(--cyan-dim);
  }
  .ring::after{
    content:'';position:absolute;inset:6px;border-radius:50%;
    background:var(--cyan); opacity:.5;
    animation:pulse 2.4s ease-in-out infinite;
  }
  .ring.busy{animation:spin 1s linear infinite; border-color:var(--amber); box-shadow:0 0 16px var(--amber);}
  .ring.busy::after{background:var(--amber); animation:pulse 0.6s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:.3;transform:scale(.85);}50%{opacity:.8;transform:scale(1);}}
  @keyframes spin{to{transform:rotate(360deg);}}
  h1{font-family:'Orbitron',sans-serif; font-size:20px; letter-spacing:2px; margin:0;}
  .eyebrow{font-size:11px; letter-spacing:3px; color:var(--text-dim); margin-top:2px;}

  textarea{
    width:100%; background:var(--panel); border:1px solid var(--border);
    color:var(--text); border-radius:8px; padding:12px; font-family:inherit;
    font-size:14px; min-height:90px; resize:vertical;
  }
  textarea:focus{outline:none; border-color:var(--cyan); box-shadow:0 0 0 3px rgba(94,231,255,.12);}

  button{
    margin-top:12px; width:100%; padding:14px; background:transparent;
    border:1px solid var(--cyan); color:var(--cyan); font-family:'Orbitron',sans-serif;
    letter-spacing:2px; font-size:13px; border-radius:8px; text-transform:uppercase;
  }
  button:active{background:rgba(94,231,255,.1);}
  button:disabled{border-color:var(--text-dim); color:var(--text-dim);}

  .panel{
    margin-top:16px; background:var(--panel); border:1px solid var(--border);
    border-radius:8px; overflow:hidden; opacity:.35; transition:opacity .4s;
  }
  .panel.active{opacity:1;}
  .panel-head{
    display:flex; justify-content:space-between; align-items:center;
    padding:10px 14px; border-bottom:1px solid var(--border); font-size:11px;
    letter-spacing:1.5px; color:var(--text-dim);
  }
  .panel-head b{color:var(--cyan); font-weight:500;}
  .status{font-size:10px; padding:2px 8px; border-radius:10px; border:1px solid var(--text-dim);}
  .status.done{color:var(--ok); border-color:var(--ok);}
  .status.err{color:var(--danger); border-color:var(--danger);}
  .panel-body{
    padding:14px; font-size:13px; line-height:1.6; white-space:pre-wrap;
    word-break:break-word; max-height:260px; overflow-y:auto;
  }
</style>
</head>
<body>

  <div class="header">
    <div class="ring" id="ring"></div>
    <div>
      <h1>J.A.R.V.I.S.</h1>
      <div class="eyebrow">CODING DIAGNOSTIC PIPELINE</div>
    </div>
  </div>

  <textarea id="input" placeholder="อธิบายปัญหาโค้ด หรือสิ่งที่อยากให้เขียน..."></textarea>
  <button id="runBtn" onclick="run()">▶ RUN DIAGNOSTIC</button>

  <div class="panel" id="p1">
    <div class="panel-head"><span><b>[01]</b> ANALYZER — GEMINI</span><span class="status" id="s1">STANDBY</span></div>
    <div class="panel-body" id="b1"></div>
  </div>
  <div class="panel" id="p2">
    <div class="panel-head"><span><b>[02]</b> PLANNER — GROQ</span><span class="status" id="s2">STANDBY</span></div>
    <div class="panel-body" id="b2"></div>
  </div>
  <div class="panel" id="p3">
    <div class="panel-head"><span><b>[03]</b> CODER — OPENROUTER</span><span class="status" id="s3">STANDBY</span></div>
    <div class="panel-body" id="b3"></div>
  </div>
  <div class="panel" id="p4">
    <div class="panel-head"><span><b>[04]</b> REVIEWER — GEMINI</span><span class="status" id="s4">STANDBY</span></div>
    <div class="panel-body" id="b4"></div>
  </div>

<script>
function run(){
  const input = document.getElementById('input').value.trim();
  if(!input) return;
  const ring = document.getElementById('ring');
  const btn = document.getElementById('runBtn');
  ring.classList.add('busy');
  btn.disabled = true; btn.textContent = 'PROCESSING...';
  ['1','2','3','4'].forEach(n=>{
    document.getElementById('s'+n).textContent='STANDBY';
    document.getElementById('s'+n).className='status';
    document.getElementById('p'+n).classList.remove('active');
    document.getElementById('b'+n).textContent='';
  });

  google.script.run
    .withSuccessHandler(onDone)
    .withFailureHandler(onFail)
    .runJarvisPipeline(input);
}

function onDone(result){
  const ring = document.getElementById('ring');
  const btn = document.getElementById('runBtn');
  ring.classList.remove('busy');
  btn.disabled = false; btn.textContent = '▶ RUN DIAGNOSTIC';

  const steps = [
    ['1', result.analysis],
    ['2', result.plan],
    ['3', result.code],
    ['4', result.review]
  ];
  steps.forEach(([n, text], i)=>{
    setTimeout(()=>{
      document.getElementById('p'+n).classList.add('active');
      document.getElementById('s'+n).textContent='DONE';
      document.getElementById('s'+n).className='status done';
      document.getElementById('b'+n).textContent = text;
    }, i*250);
  });
}

function onFail(err){
  const ring = document.getElementById('ring');
  const btn = document.getElementById('runBtn');
  ring.classList.remove('busy');
  btn.disabled = false; btn.textContent = '▶ RUN DIAGNOSTIC';
  alert('เกิดข้อผิดพลาด: ' + err.message);
}
</script>
</body>
</html>
